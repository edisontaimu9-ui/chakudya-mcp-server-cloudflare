# Local dev secrets for `wrangler dev` (copy to .dev.vars, which is
# gitignored — never commit real secrets).
#
# Non-secret config (CHAKUDYA_API_BASE_URL, MCP_ALLOWED_ORIGINS,
# MCP_RATE_LIMIT_PER_MIN) lives in wrangler.jsonc's "vars" instead, since
# it's fine to have in version control.

MCP_AUTH_TOKEN=dev-only-token-change-me
# ENVIRONMENT=development enables verbose (debug-level) logging and skips
# the "MCP_AUTH_TOKEN required" check — leave unset for prod-like local testing.
ENVIRONMENT=development

# A chakudya-api consumer key (create one on the Chakudya developer console). chakudya-api
# refuses every data route without a key, so most tools fail with a 401 until this is set.
# CHAKUDYA_API_KEY=

# Only needed if you want to test an admin-gated CNR route locally.
# CHAKUDYA_ADMIN_API_KEY=
